# -----------------------------------------------------------------------------
# Task & Time Tracker — environment variable reference
#
# This file documents every environment variable used across the monorepo.
# Copy the relevant values into:
#   - apps/api/.env       (backend)
#   - apps/api/.env.test  (backend tests — must point at a *_test database)
#   - apps/web/.env.local (frontend)
# -----------------------------------------------------------------------------

# --- apps/api ----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Origin(s) the API accepts credentialed (cookie) requests from; comma-separated.
# Must be https:// in production.
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma. Never commit a real value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_time_tracker

# Signs access-token JWTs. >= 32 chars (>= 64 in production); the placeholder is rejected.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# lax (default) | strict | none ("none" only in production, requires Secure;
# prefer the web app's API_PROXY_URL for cross-site deployments).
COOKIE_SAME_SITE=lax

# IANA timezone defining "today" for the daily summary when the client sends none.
APP_TIMEZONE=UTC

# Operations (see apps/api/.env.example for details). Empty = environment default.
LOG_LEVEL=
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=10000
API_DOCS_ENABLED=

# Per-IP rate limits (durations like 30s / 15m / 1h).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_REFRESH_RATE_LIMIT_MAX=60
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW=1m

# AI task assistant (optional). Empty AI_PROVIDER = disabled. Server-side only:
# never prefix these with NEXT_PUBLIC_ or put them in apps/web.
# AI_PROVIDER: "anthropic" or empty. AI_RATE_LIMIT_MAX is per user, per window.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_LENGTH=1000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW=15m

# Demo seed (npm run db:seed). Password required in production; share it out of band.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- apps/web ------------------------------------------------------------------
# Base URL the browser uses to reach the API (inlined at build time):
# https://api.example.com/api/v1, or /api/v1 in proxy mode.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional, server-side: the API origin to forward /api/v1/* to (proxy mode).
API_PROXY_URL=
