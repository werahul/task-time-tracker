# Base URL the browser uses to reach the API. Inlined at build time.
#   Same site (app.example.com + api.example.com): https://api.example.com/api/v1
#   Proxy mode (different sites, see API_PROXY_URL): /api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional, server-side only (never NEXT_PUBLIC_). The API's origin, e.g.
# https://task-tracker-api.onrender.com. When set, /api/v1/* on this app is
# forwarded to the API so auth cookies are first-party. Pair with
# NEXT_PUBLIC_API_URL=/api/v1. Read at build time.
API_PROXY_URL=
