NODE_ENV=development
PORT=5000

# Allowed frontend origin(s) for CORS and state-changing requests. Comma-separate
# several (e.g. production + preview). Must be https:// in production.
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma. Never commit a real value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_time_tracker

# Signs access-token JWTs. >= 32 chars (>= 64 in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The API refuses to start while this is still the placeholder below.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# lax (default) | strict | none. Keep "lax" for same-site deployments
# (app.example.com + api.example.com) and for proxy mode (see apps/web API_PROXY_URL).
# "none" (production only, requires Secure) is a last resort for cross-site setups:
# browsers that block third-party cookies (Safari) will still drop them.
COOKIE_SAME_SITE=lax

# IANA timezone that defines "today" for the daily summary when the client
# doesn't send one (the web app always sends the browser's timezone).
APP_TIMEZONE=UTC

# --- Operations ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent. Default: info (silent in tests).
# "debug" also logs a line when each request starts.
LOG_LEVEL=
# Reverse-proxy hops to trust for client IPs (rate limiting). Default: 0, or 1 in production.
# Behind the web app's /api/v1 proxy (API_PROXY_URL) there is one more hop: usually 2.
TRUST_PROXY=
# Max time to drain in-flight requests on SIGTERM/SIGINT before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000
# Serve /api/v1/docs (Swagger UI) and /api/v1/openapi.json. Default: true, false in production.
API_DOCS_ENABLED=

# --- Rate limits (per client IP; windows use 30s / 15m / 1h style durations) ---
# Login and register each allow AUTH_RATE_LIMIT_MAX per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_REFRESH_RATE_LIMIT_MAX=60
# Baseline for all /api traffic (health checks exempt).
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW=1m

# --- AI task assistant (optional) --------------------------------------------
# Leave AI_PROVIDER empty to disable AI; everything else keeps working and the
# suggest endpoint returns 503. Server-side only — never expose these to the web app.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_LENGTH=1000
# Per-user limit on POST /tasks/suggest.
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW=15m

# --- Demo seed (npm run db:seed) -----------------------------------------------
# Optional. Defaults: demo@example.com / a development-only password. In
# production DEMO_USER_PASSWORD is required; never commit it.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
