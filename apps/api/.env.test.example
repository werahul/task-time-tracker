# Copy to .env.test. Tests TRUNCATE every table between cases, so this MUST
# point at a dedicated database whose name ends in "_test" — the test setup
# refuses to run otherwise.
NODE_ENV=test
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_time_tracker_test
ACCESS_TOKEN_SECRET=test-only-secret-that-is-at-least-32-characters-long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
